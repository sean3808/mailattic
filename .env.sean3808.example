# IMAP credentials for sean3808@mailattic.test (mailattic.test mail server)
# -----------------------------------------------------------------------------
# 使用方式：
#   cp .env.sean3808.example .env.sean3808
#   編輯 .env.sean3808 填入 IMAP_PASSWORD
#
# 命名：本檔採帳號別命名（.env.sean3808 而非通用 .env），避免與
# 其他憑證檔混淆。未來加其他帳號時對稱擴展
# .env.<account>.{,example}。
#
# 載入：docker-compose.yml 的 env_file 指令會把這些變數注入到 mbsync
# container；container 內 envsubst 把 mbsyncrc.template 渲染為實際
# mbsyncrc 設定檔。
#
# -----------------------------------------------------------------------------

# IMAP 伺服器位址
IMAP_HOST=mail.mailattic.test

# IMAPS 標準埠（TLS over IMAP）
IMAP_PORT=993

# Windows-native IMAP 傳輸安全模式。省略時預設 tls（implicit TLS / IMAPS）。
# 只有無法提供 IMAPS 或 STARTTLS 的 legacy server 才可改成 plain 並搭配 143。
# 警告：plain 會讓帳密與郵件內容以明文傳輸，只能用於受信任網路或受保護 tunnel。
IMAP_SECURITY=tls

# IMAP 帳號（完整 email）
IMAP_USER=sean3808@mailattic.test

# IMAP 密碼（請從 帳號設定取得或自行設定後填入）
IMAP_PASSWORD=<your-password-here>

# 本地 mbsync 帳號識別字（決定 maildir 路徑 .mailattic-work/maildir/<NAME>/
# 與 mbsyncrc 內的 IMAPAccount 段名稱）
IMAP_ACCOUNT_NAME=sean3808

# SMTP submission credentials（outbound email，add-outbound-send-capability change）
# -----------------------------------------------------------------------------
# SMTP submission（SMTPS 465）與 IMAP 993 共用同一個郵箱帳號。
# 預設值：SMTP_HOST=IMAP_HOST, SMTP_PORT=465, SMTP_USER=IMAP_USER,
#         SMTP_PASSWORD=IMAP_PASSWORD（同一組認證）。
# 填入方式：直接複製對應的 IMAP_* 值即可。

# SMTP 伺服器位址（與 IMAP_HOST 相同）
SMTP_HOST=mail.mailattic.test

# SMTPS 標準埠（TLS over SMTP submission）
SMTP_PORT=465

# SMTP 認證帳號（與 IMAP_USER 相同，完整 email）
SMTP_USER=sean3808@mailattic.test

# SMTP 密碼（與 IMAP_PASSWORD 相同，請從 帳號設定取得）
SMTP_PASSWORD=<your-password-here>
