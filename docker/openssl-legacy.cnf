# 用於 mbsync container 內所有 OpenSSL client（含 mbsync / Python）
# 相容只接受舊式 TLS 參數的郵件伺服器：放寬 Debian 預設的 OpenSSL 安全等級
# 若日後 mail server 改用現代 TLS 設定，可移除此檔 + Dockerfile 內 OPENSSL_CONF env
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
CipherString = DEFAULT:@SECLEVEL=0
